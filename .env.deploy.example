# Local break-glass deployment settings for Capell 4.
# Copy to .env.deploy.local and fill only the values you need.

CAPELL_WEB2_HOST=web2
CAPELL_GITHUB_TOKEN=
CAPELL_SPLIT_ORG=capell-app
CAPELL_SPLIT_BRANCH=1.x
CAPELL_SCREENSHOT_RUNNER_PATH=/absolute/path/to/capell-screenshot-runner
CAPELL_PACKAGES_REPO_PATH=/absolute/path/to/capell-packages-4
