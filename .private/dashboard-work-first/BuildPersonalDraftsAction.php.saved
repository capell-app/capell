<?php

declare(strict_types=1);

namespace Capell\Admin\Actions\Dashboard;

use Capell\Admin\Data\Dashboard\MyWorkItemData;
use Capell\Admin\Data\Dashboard\MyWorkQueueData;
use Capell\Core\Actions\GetEditPageResourceUrlAction;
use Capell\Core\Models\Page;
use Capell\Core\Support\Permissions\SiteAccess;
use Illuminate\Contracts\Auth\Authenticatable;
use Illuminate\Database\Eloquent\Builder;
use Illuminate\Support\Facades\Gate;
use Spatie\LaravelData\DataCollection;

final class BuildPersonalDraftsAction
{
    public function handle(Authenticatable $actor, ?int $siteId, int $limit): MyWorkQueueData
    {
        if (! Gate::forUser($actor)->allows('viewAny', Page::class)) {
            return new MyWorkQueueData(items: MyWorkItemData::collect([], DataCollection::class));
        }

        $pages = SiteAccess::forActor($actor)->query(Page::class)
            ->draft()
            ->where('created_by', $actor->getAuthIdentifier())
            ->when($siteId !== null, fn (Builder $query): Builder => $query->where('site_id', $siteId))
            ->latest('updated_at')
            ->lazy();

        $items = $pages
            ->filter(fn (Page $page): bool => Gate::forUser($actor)->allows('view', $page))
            ->take(max(0, $limit))
            ->map(fn (Page $page): MyWorkItemData => new MyWorkItemData(
                pageId: (int) $page->getKey(),
                title: $page->name,
                kind: 'draft',
                editUrl: Gate::forUser($actor)->allows('update', $page) ? GetEditPageResourceUrlAction::run($page) : null,
                scheduledAt: null,
                updatedAt: $page->updated_at?->toIso8601String(),
            ));

        return new MyWorkQueueData(items: MyWorkItemData::collect($items->values()->all(), DataCollection::class));
    }
}
