#!/usr/bin/env bash

set -euo pipefail

script_path="${BASH_SOURCE[0]}"
repo_dir="$(cd "$(dirname "$script_path")" && pwd)"

cd "$repo_dir"

# The shared screenshot runner is a separate private checkout. Keep it outside
# the Core tree and expose it to the container read-only when it is available.
# The receipt validator is intentionally not duplicated into Core or the
# screenshot-tools companion package: both local and hosted checks must use the
# same runner implementation.
screenshot_runner_host_path="${CAPELL_SCREENSHOT_RUNNER_HOST_PATH:-}"

if [ -z "$screenshot_runner_host_path" ] \
    && [ -n "${CAPELL_SCREENSHOT_RUNNER_PATH:-}" ] \
    && [ -d "$CAPELL_SCREENSHOT_RUNNER_PATH" ]; then
    screenshot_runner_host_path="$(cd "$CAPELL_SCREENSHOT_RUNNER_PATH" && pwd)"
fi

if [ -z "$screenshot_runner_host_path" ]; then
    repository_git_common_dir="$(git rev-parse --git-common-dir 2>/dev/null || true)"

    case "${repository_git_common_dir:-}" in
        '') ;;
        /*) ;;
        *) repository_git_common_dir="$(cd "$repository_git_common_dir" 2>/dev/null && pwd || true)" ;;
    esac

    if [ -n "${repository_git_common_dir:-}" ]; then
        repository_root="$(dirname "$repository_git_common_dir")"
        candidate="$(cd "$repository_root/.." 2>/dev/null && pwd || true)/capell-screenshot-runner"

        if [ -d "$candidate" ]; then
            screenshot_runner_host_path="$candidate"
        fi
    fi
fi

if [ -n "$screenshot_runner_host_path" ]; then
    export CAPELL_SCREENSHOT_RUNNER_HOST_PATH="$screenshot_runner_host_path"

    screenshot_runner_overlay='# Generated by ./capell for the shared screenshot runner. Do not edit or commit.
# Mounts the runner read-only so receipt and capture checks use the canonical
# implementation without copying it into this repository.
services:
  app:
    volumes:
      - "${CAPELL_SCREENSHOT_RUNNER_HOST_PATH}:/home/capell/screenshot-runner:ro"
    environment:
      CAPELL_SCREENSHOT_RUNNER_PATH: /home/capell/screenshot-runner
'

    if [ ! -f docker-compose.screenshot-runner.local.yml ] \
        || [ "$(cat docker-compose.screenshot-runner.local.yml)" != "$(printf '%s' "$screenshot_runner_overlay")" ]; then
        printf '%s' "$screenshot_runner_overlay" > docker-compose.screenshot-runner.local.yml
    fi

    export COMPOSE_FILE="${COMPOSE_FILE:-docker-compose.yml}:docker-compose.screenshot-runner.local.yml"
fi

# Worktree git metadata. In a linked git worktree the checkout's `.git` is a
# file naming the primary checkout's shared administrative directory by its
# host-absolute path, and git resolves that pointer verbatim. That path does
# not exist inside the container, so every in-container git consumer fails —
# `composer lint:changed`, `rector:changed`, `phpstan:baseline-check`, and
# `vendor/bin/pint --dirty`. Generate a local Compose overlay mounting the
# shared directory read-only at the same path. Read-only is sufficient: none of
# those commands write to the repository. No-op in a primary checkout, where
# `.git` is a real directory already covered by the `.:/home/capell/current`
# mount.
if [ -f .git ] && [ ! -d .git ]; then
    git_common_dir="$(git rev-parse --git-common-dir 2>/dev/null || true)"

    case "${git_common_dir:-}" in
        '') ;;
        /*) ;;
        *) git_common_dir="$(cd "$git_common_dir" 2>/dev/null && pwd || true)" ;;
    esac

    if [ -n "${git_common_dir:-}" ]; then
        export CAPELL_GIT_COMMON_DIR="$git_common_dir"

        # Static content interpolated by Compose at run time, so the generated
        # file is identical for every worktree and cannot go stale.
        worktree_git_overlay='# Generated by ./capell for linked git worktrees. Do not edit or commit.
# Mounts the primary checkout'"'"'s shared .git directory read-only at its
# host-absolute path so git inside the container can resolve this worktree'"'"'s
# gitdir pointer (the .git file names that path verbatim).
services:
  app:
    volumes:
      - "${CAPELL_GIT_COMMON_DIR}:${CAPELL_GIT_COMMON_DIR}:ro"
'

        if [ ! -f docker-compose.worktree-git.local.yml ] \
            || [ "$(cat docker-compose.worktree-git.local.yml)" != "$(printf '%s' "$worktree_git_overlay")" ]; then
            printf '%s' "$worktree_git_overlay" > docker-compose.worktree-git.local.yml
        fi

        if [ -n "${COMPOSE_FILE:-}" ]; then
            export COMPOSE_FILE="${COMPOSE_FILE}:docker-compose.worktree-git.local.yml"
        else
            export COMPOSE_FILE="docker-compose.yml:docker-compose.worktree-git.local.yml"
        fi
    fi
fi

compose_command=()
app_exec=()
app_run=()

if docker compose version >/dev/null 2>&1; then
    compose_command=(docker compose)
elif command -v docker-compose >/dev/null 2>&1; then
    compose_command=(docker-compose)
else
    echo "Docker Compose is not available. Install Docker with the Compose plugin, then try again." >&2

    exit 1
fi

# Every linked worktree has a distinct administrative directory under the
# shared Git common directory, even when all checkouts are named capell-4.
# Derive the Compose project from that ID so one worktree cannot recreate or
# attach to another worktree's services. Primary checkouts retain the repo
# name for backwards compatibility.
compose_project_name="$(basename "$repo_dir")"
if [ -f .git ] && [ ! -d .git ]; then
    worktree_git_dir="$(git rev-parse --git-dir 2>/dev/null || true)"
    case "$worktree_git_dir" in
        */worktrees/*) compose_project_name="capell-$(basename "$worktree_git_dir")" ;;
    esac
fi
compose_command+=(--project-name "$compose_project_name")

app_exec=("${compose_command[@]}" exec --user capell --env HOME=/home/capell --env COMPOSER_HOME=/home/capell/.config/composer app)
test_exec=("${compose_command[@]}" exec --user capell --env HOME=/home/capell --env COMPOSER_HOME=/home/capell/.config/composer --env APP_ENV=testing --env DB_CONNECTION=sqlite --env DB_DATABASE=:memory: --env DB_URL= app)
app_run=("${compose_command[@]}" run --rm --no-deps --user capell --env HOME=/home/capell --env COMPOSER_HOME=/home/capell/.config/composer app)

usage() {
    cat <<'EOF'
Usage: ./capell <command> [args]

Docker harness commands:
  up                    Build and start harness services
  down                  Stop and remove harness services
  restart               Restart harness services
  ps, status            Show service status
  logs [service]        Show service logs
  shell, bash [cmd]     Open a bash shell or run a bash command in the app container
  sh [cmd]              Open a sh shell or run a sh command in the app container

App container shortcuts:
  composer [args]       Run Composer in the app container
  npm [args]            Run npm in the app container
  pint [args]           Run Laravel Pint in the app container
  test [args]           Run composer test in the app container
  pest [args]           Run vendor/bin/pest in the app container
  analyze [args]        Run composer analyze in the app container
  lint [args]           Run composer lint in the app container
  preflight [args]      Run composer preflight in the app container
  preflight-all [args]  Run composer preflight:all in the app container

Pass-through:
  exec <command>        Run a command in the running app container
  run <command>         Run a one-off app container without dependencies
  compose [args]        Pass arguments directly to docker compose

Examples:
  ./capell up
  ./capell composer install
  ./capell test -- --filter=SomeTest
  ./capell run composer test
  ./capell compose ps
EOF
}

command_name="${1:-help}"

if [ "$#" -gt 0 ]; then
    shift
fi

case "$command_name" in
    help|-h|--help)
        usage
        ;;
    up|start)
        "${compose_command[@]}" up -d "$@"
        ;;
    down|stop)
        "${compose_command[@]}" down "$@"
        ;;
    restart)
        "${compose_command[@]}" down "$@"
        "${compose_command[@]}" up -d
        ;;
    ps|status)
        "${compose_command[@]}" ps "$@"
        ;;
    logs)
        "${compose_command[@]}" logs "$@"
        ;;
    shell|bash)
        if [ "$#" -gt 0 ]; then
            "${app_exec[@]}" bash -lc "$*"
        else
            "${app_exec[@]}" bash
        fi
        ;;
    sh)
        if [ "$#" -gt 0 ]; then
            "${app_exec[@]}" sh -lc "$*"
        else
            "${app_exec[@]}" sh
        fi
        ;;
    composer)
        if [[ "${1:-}" = test* || "${1:-}" = preflight* ]]; then
            "${test_exec[@]}" composer "$@"
        else
            "${app_exec[@]}" composer "$@"
        fi
        ;;
    npm)
        "${app_exec[@]}" npm "$@"
        ;;
    pint)
        "${app_exec[@]}" vendor/bin/pint "$@"
        ;;
    test)
        "${test_exec[@]}" composer test "$@"
        ;;
    pest)
        "${test_exec[@]}" vendor/bin/pest "$@"
        ;;
    analyze)
        "${app_exec[@]}" composer analyze "$@"
        ;;
    lint)
        "${app_exec[@]}" composer lint "$@"
        ;;
    preflight)
        "${app_exec[@]}" composer preflight "$@"
        ;;
    preflight-all)
        "${app_exec[@]}" composer preflight:all "$@"
        ;;
    exec)
        if [ "$#" -eq 0 ]; then
            echo "Usage: ./capell exec <command>" >&2

            exit 1
        fi

        "${app_exec[@]}" "$@"
        ;;
    run)
        if [ "$#" -eq 0 ]; then
            echo "Usage: ./capell run <command>" >&2

            exit 1
        fi

        "${app_run[@]}" "$@"
        ;;
    compose)
        "${compose_command[@]}" "$@"
        ;;
    *)
        echo "Unknown command: $command_name" >&2
        echo >&2
        usage >&2

        exit 1
        ;;
esac
