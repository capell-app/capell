%% Canonical source for capell-core-composition-erd.svg.
%% Source trails:
%% - Core record edges: packages/core/src/Models/{Site,Page,Layout,Theme,Translation,PageUrl,Language,Blueprint}.php
%%   and packages/core/src/Models/Concerns/{HasAssets,HasBlueprint}.php.
%% - Asset join edges: packages/core/src/Models/{AssetAttachment,Media}.php and
%%   packages/core/database/migrations/2026_05_10_190832_15_create_asset_attachments_table.php.
%% - Optional Layout Builder material: capell-packages-4/packages/layout-builder/README.md
%%   and packages/layout-builder/src/Models/{Widget,WidgetAsset}.php.
%% - Public boundary: packages/frontend/src/Actions/{BuildPublicPageRenderDataAction,AssertPublicHtmlContainsNoAuthoringSurfaceAction}.php,
%%   packages/frontend/src/Support/Security/PublicHtmlSafetyInspector.php, and docs/frontend/public-html-safety.md.
%% - Provider/runtime boundary is documented beside this source in
%%   docs/reference/architecture-diagrams.md: packages/core/src/Support/PackageRegistry/RuntimeContextResolver.php,
%%   packages/core/src/Support/Packages/PackageSurfaceRegistrar.php, and capell.json provider buckets.
flowchart TB
    subgraph foundation["Core-owned foundation records"]
        direction LR
        site["sites<br/>Site"]
        page["pages<br/>Page"]
        blueprint["blueprints<br/>Blueprint"]
        layout["layouts<br/>Layout"]
        theme["themes<br/>Theme"]
        language["languages<br/>Language"]
        translation["translations<br/>Translation"]
        pageUrl["page_urls<br/>PageUrl"]
        media["media<br/>Media"]
        attachment["asset_attachments<br/>AssetAttachment"]

        site -->|"pages() / site()"| page
        page -->|"blueprint()"| blueprint
        page -->|"layout()"| layout
        layout -->|"theme()"| theme
        page -->|"pageUrls()"| pageUrl
        translation -->|"language()"| language
        pageUrl -->|"language()"| language
        page -->|"HasAssets::assets()"| attachment
        attachment -->|"asset()"| media
    end

    subgraph optionalLayout["Optional Layout Builder material"]
        direction LR
        widgets["widgets<br/>Widget"]
        widgetAssets["widget_assets<br/>WidgetAsset"]
        widgets -->|"optional widget asset rows"| widgetAssets
    end

    layout -.->|"optional package composition"| widgets

    subgraph delivery["Separate delivery and authoring paths"]
        renderData["hydrated public render data"]
        publicHtml["public HTML"]
        publicCache["shared HTML/static cache"]
        authoring["authenticated authoring path"]
        beacon["post-load authoring beacon"]
        controls["admin-only controls"]
        privatePreview["private preview response"]

        renderData --> publicHtml
        publicHtml --> publicCache
        authoring --> beacon
        beacon --> controls
        controls -.->|"never enters"| publicCache
        authoring --> privatePreview
    end

    subgraph lifecycle["Different lifecycle concepts"]
        providerBuckets["capell.json manifest-v3 provider buckets<br/>metadata · install · runtime · admin · frontend"]
        runtimeContexts["RuntimeContextResolver contexts<br/>install · runtime · admin · frontend"]
        providerBuckets -.->|"declared buckets ≠ resolved contexts"| runtimeContexts
    end

    classDef core fill:#f4efe3,stroke:#7f5b1c,color:#241b0d,stroke-width:1.5px;
    classDef optional fill:#e9f4f1,stroke:#277d73,color:#123b37,stroke-width:1.5px;
    classDef public fill:#eaf1f8,stroke:#31648c,color:#102c43,stroke-width:1.5px;
    classDef authoring fill:#f6e8e8,stroke:#9b4c4c,color:#451f1f,stroke-width:1.5px;
    class site,page,blueprint,layout,theme,language,translation,pageUrl,media,attachment core;
    class widgets,widgetAssets optional;
    class renderData,publicHtml,publicCache public;
    class authoring,beacon,controls,privatePreview authoring;
