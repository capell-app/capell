%% Canonical source for capell-extension-package-surface-map.svg.
%% Source trails:
%% - Core package contract: packages/core/src/Support/Packages/PackageSurfaceRegistrar.php.
%% - Admin contract: packages/admin/src/Support/Bridges/AdminBridgeRegistrar.php and
%%   packages/admin/src/Contracts/Extenders/PageSchemaExtender.php.
%% - Frontend contracts: packages/frontend/src/Support/Assets/FrontendResourceRegistry.php
%%   and packages/frontend/src/Support/Render/FrontendHookRegistrar.php.
%% - Concrete package: capell-packages-4/packages/extension-cookbook/{capell.json,
%%   src/Providers/ExtensionCookbookServiceProvider.php,src/Bridges/ExtensionCookbookAdminBridge.php,
%%   src/Filament/Extenders/ExtensionCookbookPageSchemaExtender.php,
%%   src/Providers/FrontendServiceProvider.php}.
%% - Recipe explanation: capell-packages-4/docs/package-extension-platform.md and
%%   capell-packages-4/packages/extension-cookbook/docs/extension-points.md.
flowchart LR
    manifest["Extension Cookbook<br/>capell.json"] --> provider["ExtensionCookbookServiceProvider"]
    provider -->|"surface()"| coreRegistrar["PackageSurfaceRegistrar"]
    coreRegistrar -->|"models / blueprint / events / settings"| coreSurface["Core-owned package surfaces"]

    bridge["ExtensionCookbookAdminBridge"] -->|"register(...)"| adminRegistrar["AdminBridgeRegistrar"]
    adminRegistrar -->|"page / resource / configurator"| adminSurface["Admin surface"]
    adminRegistrar -->|"PageSchemaExtender"| schema["Page editor schema extension"]
    schema -->|"extendSidebarComponents()"| sidebar["Translated sidebar help"]

    frontend["FrontendServiceProvider"] -->|"register(...)"| resources["FrontendResourceRegistry"]
    resources -->|"typed resource group"| publicAssets["Public CSS and JS resources"]
    frontend -->|"contribute(...)"| hooks["FrontendHookRegistrar<br/>cache-safe render hook"]
    frontend -->|"register(...)"| widgets["WidgetExtensionRegistrar<br/>public widget payload"]

    cookbook["Extension Cookbook docs"] -.->|"source-backed recipes"| coreSurface
    cookbook -.->|"source-backed recipes"| adminSurface
    cookbook -.->|"source-backed recipes"| publicAssets
