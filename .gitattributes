# Path-based git attributes
# https://www.kernel.org/pub/software/scm/git/docs/gitattributes.html

# Keep development files in Git, outside Composer release archives.
/.github            export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/tests              export-ignore
/.editorconfig      export-ignore

* text=auto eol=lf
*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

# Development tooling and lockfiles do not belong in library distributions.
/.docker export-ignore
/.dockerignore export-ignore
/.env.deploy.example export-ignore
/.coveragerc export-ignore
/.eslintrc.json export-ignore
/.pre-commit export-ignore
/.pre-commit-config.yaml export-ignore
/.prettierignore export-ignore
/.prettierrc export-ignore
/artwork export-ignore
/capell export-ignore
/codecov.yml export-ignore
/config/release-packages.json export-ignore
/config/support-policy.json export-ignore
/docker-compose*.yml export-ignore
/phpstan export-ignore
/phpstan.neon export-ignore
/phpunit*.xml export-ignore
/testbench.yaml export-ignore
/pint.json export-ignore
/rector.php export-ignore
/ray.php export-ignore
/composer.lock export-ignore
/package.json export-ignore
/package-lock.json export-ignore
/playwright.config.js export-ignore
/screenshots.config.mjs export-ignore
/release-plan.json export-ignore
/scripts export-ignore
/workbench export-ignore
/AGENTS.md export-ignore
/CLAUDE.md export-ignore
/CHANGELOG.md export-ignore
/CONTRIBUTING.md export-ignore
/.claude export-ignore
/.codex export-ignore
/.agents export-ignore

# The aggregate also embeds split-package development files.
/packages/*/.github export-ignore
/packages/*/.gitattributes export-ignore
/packages/*/AGENTS.md export-ignore
/packages/*/CLAUDE.md export-ignore
/packages/*/tests export-ignore
/packages/*/rector.php export-ignore
/packages/*/phpunit*.xml* export-ignore
/packages/*/phpstan* export-ignore
/packages/*/pint.json export-ignore
/packages/*/composer.lock export-ignore
/packages/*/package.json export-ignore
/packages/*/package-lock.json export-ignore
/packages/*/tailwind.config.* export-ignore
/packages/*/vite.config.* export-ignore
/packages/*/scripts export-ignore

