includes:
    - phpstan/extensions.neon
    - phpstan/common.neon

parameters:
    treatPhpDocTypesAsCertain: false
    parallel:
        maximumNumberOfProcesses: 4
    paths:
        - packages
        - tests
        - scripts/benchmark-boot.php
        - scripts/benchmark-boot-child.php
        - scripts/benchmark-boot-support.php
    scanFiles:
        - scripts/release/ReleaseEligibility.php
        - scripts/test-all/TestAllMatrix.php
    tmpDir: %currentWorkingDirectory%/var/phpstan/full
