{
    "manifest-version": 3,
    "name": "{{ packageName }}",
    "slug": "{{ slug }}",
    "displayName": "{{ jsonDisplayName }}",
    "kind": "package",
    "capellApiVersion": "^1.0",
    "version": "1.0.0",
    "description": "{{ jsonDisplayName }} for Capell.",
    "demo": true,
    "product": {
        "group": "{{ jsonDisplayName }}",
        "tier": "{{ tier }}",
        "bundle": null
    },
    "namespace": "{{ escapedNamespace }}",
    "surfaces": ["admin", "frontend", "console", "shared"],
    "dependencies": {
        "requires": ["capell-app/core", "capell-app/admin", "capell-app/frontend", "capell-app/layout-builder"],
        "supports": [],
        "conflicts": []
    },
    "providers": {
        "metadata": ["{{ escapedMetadataProvider }}"],
        "install": ["{{ escapedInstallProvider }}"],
        "runtime": [],
        "admin": ["{{ escapedAdminProvider }}"],
        "frontend": []
    },
    "contributes": [
        {
            "type": "content-widget",
            "key": "{{ widgetKey }}",
            "class": "{{ escapedNamespace }}\\ExampleWidgetContribution"
        },
        {
            "type": "setting",
            "class": "{{ escapedNamespace }}\\PackageSettingsContribution",
            "settingsClass": "{{ escapedNamespace }}\\Settings\\PackageSettings",
            "settingsGroup": "{{ settingsGroup }}",
            "keys": ["settings-class:{{ settingsGroup }}", "settings-metadata:{{ settingsGroup }}"]
        },
        {
            "type": "admin-page",
            "class": "{{ escapedNamespace }}\\SettingsManagementContribution",
            "keys": ["extension-management-surface:{{ packageName }}:settings:{{ settingsGroup }}"]
        }
    ],
    "database": {
        "migrations": false,
        "settings": true,
        "requiredTables": []
    },
    "actions": {
        "install": null,
        "setup": null,
        "uninstall": null,
        "afterInstall": null
    },
    "commands": {
        "doctor": null
    },
    "settings": ["{{ escapedNamespace }}\\Settings\\PackageSettings"],
    "permissions": [],
    "capabilities": ["frontend-assets", "frontend-rendering"],
    "performance": {
        "frontendRenderBudgetMs": 10,
        "adminQueryBudget": 20,
        "cacheTags": ["{{ slug }}"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": [],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [],
    "commercial": {
        "proposedLicense": "{{ tier }}",
        "requestedCertification": "community",
        "supportPolicy": "community",
        "privateDocsRequested": false
    },
    "marketplace": {
        "summary": "{{ jsonDisplayName }} safe extension examples for Capell.",
        "screenshots": [],
        "categories": ["developer-tools"]
    }
}
