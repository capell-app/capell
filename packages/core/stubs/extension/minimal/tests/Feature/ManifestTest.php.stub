<?php

declare(strict_types=1);

use Capell\Core\Testing\ExtensionTestHarness;

it('has a valid Capell package manifest', function (): void {
    ExtensionTestHarness::forPath(dirname(__DIR__, 2))
        ->assertManifestValid()
        ->assertNoUnsafePublicCache();

    // The harness throws on the first contract failure, so reaching this line means every check passed.
    $this->addToAssertionCount(1);
});
