<?php

declare(strict_types=1);

use Illuminate\Support\Facades\Blade;

it('renders the {{ name }} asset component around its slot', function (): void {
    $template = file_get_contents(dirname(__DIR__, 3) . '/resources/views/components/asset/{{ name }}.blade.php');

    expect(Blade::render((string) $template, ['slot' => 'Asset content']))->toContain('Asset content');
});
