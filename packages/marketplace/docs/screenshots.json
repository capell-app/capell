{
    "package": "marketplace",
    "composerName": "capell-app/marketplace",
    "generatedFor": "shared-capell-screenshot-runner",
    "provenancePolicy": "runner-only-v1",
    "requiresInstalledPackage": true,
    "outputDirectory": "packages/marketplace/docs/images/screenshots",
    "entries": [
        {
            "id": "marketplace-extensions-page",
            "title": "Extensions page marketplace status.",
            "package": "marketplace",
            "surface": "admin",
            "targetType": "admin-surface",
            "target": "ExtensionsPage",
            "scenario": "admin-index",
            "url": "/extensions",
            "waitFor": "table",
            "required": true,
            "sameCaptureAs": "admin-extensions-page",
            "notes": "Resolved by the deployment screenshot runner after marketplace example data is prepared. Marketplace contributes the connection alert but not catalogue controls to the installed Extensions page."
        },
        {
            "id": "extension-update-advisories",
            "title": "Extension update advisories.",
            "package": "marketplace",
            "surface": "admin",
            "targetType": "admin-surface",
            "target": "ExtensionsPage",
            "scenario": "admin-index",
            "url": "/extensions",
            "waitFor": "table",
            "required": true,
            "sameCaptureAs": "marketplace-extensions-page",
            "notes": "Resolved by the deployment screenshot runner after advisory snapshots are seeded. Marketplace contributes alerts but not catalogue controls to the installed Extensions page."
        },
        {
            "id": "marketplace-extension-update-confirmation",
            "title": "Marketplace extension update confirmation modal.",
            "package": "marketplace",
            "surface": "admin",
            "targetType": "admin-surface",
            "target": "ExtensionsPage",
            "scenario": "admin-index",
            "url": "/extensions",
            "waitFor": "table",
            "docsPage": "packages/marketplace/README.md",
            "output": "packages/marketplace/docs/images/screenshots/marketplace-extension-update-confirmation.png",
            "required": false,
            "notes": "Resolved by the deployment screenshot runner after marketplace example data seeds an update-eligible extension row, then opens the row's update action. Covers MarketplaceCatalogueTable's updateMarketplaceExtension confirmation modal (name and current-version copy).",
            "covers": [
                "packages/marketplace/src/Filament/Support/MarketplaceCatalogueTable.php"
            ]
        },
        {
            "id": "marketplace-operator-action-error-notification",
            "title": "Marketplace operator action failure notification.",
            "package": "marketplace",
            "surface": "admin",
            "targetType": "admin-surface",
            "target": "MarketplacePackageOperationsPage",
            "scenario": "admin-index",
            "url": "/extensions/package-operations",
            "waitFor": "table",
            "docsPage": "packages/marketplace/README.md",
            "output": "packages/marketplace/docs/images/screenshots/marketplace-operator-action-error-notification.png",
            "required": false,
            "notes": "Resolved by the deployment screenshot runner after a seeded operator action failure triggers the danger notification. Covers MarketplaceErrorPresenter's persistent toast and its View details action linking to Package Operations.",
            "covers": [
                "packages/marketplace/src/Filament/Support/MarketplaceErrorPresenter.php"
            ]
        },
        {
            "id": "marketplace-extension-detail-overview",
            "title": "Marketplace extension detail overview.",
            "package": "marketplace",
            "surface": "admin",
            "targetType": "admin-surface",
            "target": "MarketplaceExtensionDetailPage",
            "scenario": "admin-index",
            "url": "/extensions/marketplace/seo-suite",
            "waitFor": "body:has([data-marketplace-extension-screenshots]):has([data-marketplace-extension-docs])",
            "docsPage": "packages/marketplace/README.md",
            "output": "packages/marketplace/docs/images/screenshots/marketplace-extension-detail-overview.png",
            "required": true,
            "capture": {
                "fullPage": true
            },
            "notes": "Requires the screenshot environment to provide a marketplace detail fixture for seo-suite with screenshots, documentation, licence, surfaces, dependencies, contribution summary, and feedback entitlement.",
            "sameCaptureAs": "docs-marketplace-extension-detail-overview"
        },
        {
            "id": "marketplace-extension-detail-mobile",
            "title": "Marketplace extension detail mobile layout.",
            "package": "marketplace",
            "surface": "admin",
            "targetType": "admin-surface",
            "target": "MarketplaceExtensionDetailPage",
            "scenario": "admin-index",
            "url": "/extensions/marketplace/seo-suite",
            "waitFor": "[data-marketplace-extension-screenshots]",
            "viewport": "mobile",
            "docsPage": "packages/marketplace/README.md",
            "output": "packages/marketplace/docs/images/screenshots/marketplace-extension-detail-mobile.png",
            "required": true,
            "capture": {
                "fullPage": true
            },
            "notes": "Captures the same seeded detail fixture at mobile width so screenshot galleries, docs, access state, and feedback controls are checked responsively."
        },
        {
            "id": "marketplace-extension-detail-docs-and-access",
            "title": "Marketplace extension docs and access state.",
            "package": "marketplace",
            "surface": "admin",
            "targetType": "admin-surface",
            "target": "MarketplaceExtensionDetailPage",
            "scenario": "admin-index",
            "url": "/extensions/marketplace/seo-suite",
            "waitFor": "body:has([data-marketplace-extension-screenshots]):has([data-marketplace-extension-docs])",
            "docsPage": "packages/marketplace/README.md",
            "output": "packages/marketplace/docs/images/screenshots/marketplace-extension-detail-docs-and-access.png",
            "required": true,
            "capture": {
                "fullPage": true
            },
            "notes": "Shows the external documentation CTA beside install eligibility, licence state, Marketplace access actions, version history, and feedback controls.",
            "sameCaptureAs": "marketplace-extension-detail-overview"
        }
    ]
}
