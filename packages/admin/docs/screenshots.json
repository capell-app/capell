            "target": "MediaAIEditActionExtender",
            "scenario": "admin-index",
            "url": "/media",
            "waitFor": "table",
            "docsPage": "packages/media-ai/docs/overview.md",
            "output": "packages/admin/docs/images/screenshots/admin-media-ai-doctor-image.png",
            "required": false,
            "notes": "Optional until the manifest grows action-dialog steps; points at the media surface used by Media AIOrchestrator.",
