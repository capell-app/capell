{
    "package": "admin",
    "composerName": "capell-app/admin",
    "generatedFor": "deployment-screenshot-runner",
    "requiresInstalledPackage": true,
    "outputDirectory": "packages/admin/docs/images/screenshots",
    "entries": [
        {
            "id": "admin-dashboard",
            "title": "Admin dashboard.",
            "package": "admin",
            "surface": "admin",
            "targetType": "admin-surface",
            "target": "CapellDashboard",
            "docsPage": "packages/admin/docs/overview.md",
            "output": "packages/admin/docs/images/screenshots/admin-dashboard.png",
            "required": true,
            "notes": "Used in the Admin overview to orient editors around the Filament dashboard.",
            "covers": ["packages/admin/src/Filament/Pages/CapellDashboard.php"]
        },
        {
            "id": "site-health-page",
            "title": "Site Health page.",
            "package": "admin",
            "surface": "admin",
            "targetType": "admin-surface",
            "target": "SiteHealthPage",
            "scenario": "admin-index",
            "url": "/site-health",
            "waitFor": "body",
            "docsPage": "packages/admin/docs/overview.md",
            "output": "packages/admin/docs/images/screenshots/site-health-page.png",
            "required": true,
            "notes": "Shows cache status, public-output safety, static generation, optimizer readiness, and server checks.",
            "sameCaptureAs": "site-health-page"
        },
        {
            "id": "admin-pages-list",
            "title": "Pages list.",
            "package": "admin",
            "surface": "admin",
            "targetType": "admin-surface",
            "target": "PageResource",
            "scenario": "admin-index",
            "url": "/pages",
            "waitFor": "tr:has-text('Scheduled page without an active URL'):has-text('Scheduled'):has-text('No active URL')",
            "interactions": [
                {
                    "type": "scrollIntoView",
                    "selector": "tr:has-text('Scheduled page without an active URL'):has-text('Scheduled'):has-text('No active URL')"
                }
            ],
            "docsPage": "packages/admin/docs/overview.md",
            "output": "packages/admin/docs/images/screenshots/admin-pages-list.png",
            "required": true,
            "notes": "Uses deterministic local seed data at the real Pages resource URL to show a scheduled page whose only public URL is disabled."
        },
        {
            "id": "admin-layouts-list",
            "title": "Layouts list.",
            "package": "admin",
            "surface": "admin",
            "targetType": "admin-surface",
            "target": "LayoutResource",
            "scenario": "admin-index",
            "url": "/layouts",
            "waitFor": ".capell-layout-card-record:has-text('Disabled unused layout'):has-text('Disabled'):has-text('Unused layout')",
            "interactions": [
                {
                    "type": "scrollIntoView",
                    "selector": ".capell-layout-card-record:has-text('Disabled unused layout'):has-text('Disabled'):has-text('Unused layout')"
                }
            ],
            "docsPage": "packages/admin/docs/overview.md",
            "output": "packages/admin/docs/images/screenshots/admin-layouts-list.png",
            "required": false,
            "notes": "Uses deterministic local seed data at the real Layouts resource URL to show a disabled layout with no page uses.",
            "covers": [
                "packages/admin/src/Filament/Resources/Layouts/Tables/LayoutsTable.php"
            ]
        },
        {
            "id": "admin-media-list",
            "title": "Media list.",
            "package": "admin",
            "surface": "admin",
            "targetType": "admin-surface",
            "target": "MediaResource",
            "scenario": "admin-index",
            "url": "/media",
            "waitFor": ".fi-ta",
            "interactions": [
                {
                    "type": "waitFor",
                    "selector": ".fi-ta-row:has-text('capell-logo-reference.png'):has-text('No tracked uses')"
                },
                {
                    "type": "scrollIntoView",
                    "selector": ".fi-ta-row:has-text('capell-logo-reference.png'):has-text('No tracked uses')"
                }
            ],
            "docsPage": "packages/admin/docs/overview.md",
            "output": "packages/admin/docs/images/screenshots/admin-media-list.png",
            "required": true,
            "notes": "Uses deterministic local seed data at the real Media resource URL to show an asset with zero tracked usage."
        },
        {
            "id": "admin-media-edit-focal-point",
            "title": "Media focal point editor.",
            "package": "admin",
            "surface": "admin",
            "targetType": "admin-surface",
            "target": "MediaResource/EditMedia",
            "scenario": "admin-index",
            "url": "/media/{first-record}/edit",
            "waitFor": ".fi-sc-tabs:has(button[role='tab']:has-text('Crop and focal point'))",
            "docsPage": "packages/admin/docs/overview.md",
            "output": "packages/admin/docs/images/screenshots/admin-media-edit-focal-point.png",
            "required": false,
            "notes": "Optional crop-tab capture at the real Media edit URL, backed by deterministic local zero-tracked-usage seed data."
        },
        {
            "id": "admin-media-edit-localized-metadata",
            "title": "Media localized metadata editor.",
            "package": "admin",
            "surface": "admin",
            "targetType": "admin-surface",
            "target": "MediaResource/EditMedia",
            "scenario": "admin-index",
            "url": "/media/{first-record}/edit",
            "waitFor": ".fi-sc-tabs:has(button[role='tab']:has-text('Metadata'))",
            "beforeWait": [
                {
                    "type": "click",
                    "selector": "button[role='tab']:has-text('Metadata')"
                }
            ],
            "interactions": [
                {
                    "type": "waitFor",
                    "selector": ".fi-sc-tabs-tab:has(.fi-section-header-heading:has-text('Localized metadata'))"
                },
                {
                    "type": "scrollIntoView",
                    "selector": ".fi-sc-tabs-tab:has(.fi-section-header-heading:has-text('Localized metadata'))"
                }
            ],
            "docsPage": "packages/admin/docs/overview.md",
            "output": "packages/admin/docs/images/screenshots/admin-media-edit-localized-metadata.png",
            "required": false,
            "notes": "Optional metadata-tab capture at the real Media edit URL, including the deterministic local zero-tracked-usage state."
        },
        {
            "id": "admin-page-layout-select-record-states",
            "title": "Page layout selector record states.",
            "package": "admin",
            "surface": "admin",
            "targetType": "admin-surface",
            "target": "PageResource/EditPage/LayoutSelect",
            "scenario": "admin-index",
            "url": "/pages/{first-record}/edit",
            "waitFor": ".fi-select-input-option:has(.select-option-label)",
            "beforeWait": [
                {
                    "type": "scrollIntoView",
                    "selector": ".fi-section:has(.fi-section-header-heading:has-text('Page configuration'))"
                },
                {
                    "type": "click",
                    "selector": ".fi-section:has(.fi-section-header-heading:has-text('Page configuration')) .fi-section-header"
                },
                {
                    "type": "scrollIntoView",
                    "selector": ".fi-fo-field:has(label[for='form.layout_id'])"
                },
                {
                    "type": "click",
                    "selector": ".fi-fo-field:has(label[for='form.layout_id']) .fi-select-input-btn"
                },
                {
                    "type": "fill",
                    "selector": ".fi-fo-field:has(label[for='form.layout_id']) input[aria-label='Search']",
                    "value": "Disabled unused layout"
                }
            ],
            "interactions": [
                {
                    "type": "waitFor",
                    "selector": ".fi-fo-field:has(label[for='form.layout_id']) .fi-select-input-option:has(.select-option-label:has-text('Disabled unused layout')):has-text('Disabled'):has-text('Unused layout')"
                },
                {
                    "type": "scrollIntoView",
                    "selector": ".fi-fo-field:has(label[for='form.layout_id']) .fi-select-input-option:has(.select-option-label:has-text('Disabled unused layout')):has-text('Disabled'):has-text('Unused layout')"
                }
            ],
            "docsPage": "packages/admin/docs/overview.md",
            "output": "packages/admin/docs/images/screenshots/admin-page-layout-select-record-states.png",
            "required": false,
            "notes": "Opens Filament's HTML-enabled searchable LayoutSelect so the disabled and unused state chips and page count render inside the dropdown option.",
            "covers": [
                "packages/admin/src/Filament/Components/Forms/Page/LayoutSelect.php"
            ]
        },
        {
            "id": "page-history-timeline",
            "title": "Page history timeline.",
            "package": "admin",
            "surface": "admin",
            "targetType": "admin-surface",
            "target": "PageResource/EditPage/EventSourcedHistoryRelationManager",
            "scenario": "admin-index",
            "url": "/pages/{first-record}/edit",
            "waitFor": "button[wire\\:click*='rollback']",
            "beforeWait": [
                {
                    "type": "click",
                    "selector": "button[wire\\:click*=\"activeRelationManager\"][wire\\:click*=\"'1'\"]"
                }
            ],
            "interactions": [
                {
                    "type": "waitFor",
                    "selector": ".fi-ta"
                },
                {
                    "type": "scrollIntoView",
                    "selector": ".fi-ta"
                }
            ],
            "docsPage": "packages/admin/docs/overview.md",
            "output": "packages/admin/docs/images/screenshots/page-history-timeline.png",
            "required": true,
            "notes": "Authentic populated Standard Admin Page History capture showing append-only edit and restore revisions, the current version, and available rollback and roll-forward actions."
        },
        {
            "id": "page-history-rollback-preview",
            "title": "Page history rollback and roll-forward preview.",
            "package": "admin",
            "surface": "admin",
            "targetType": "admin-action-modal",
            "target": "EventSourcedHistoryRelationManager/rollback",
            "scenario": "admin-index",
            "url": "/pages/{first-record}/edit",
            "waitFor": ".fi-modal-open",
            "beforeWait": [
                {
                    "type": "click",
                    "selector": "button[wire\\:click*=\"activeRelationManager\"][wire\\:click*=\"'1'\"]"
                },
                {
                    "type": "click",
                    "selector": "button[wire\\:click*='rollback']"
                }
            ],
            "docsPage": "packages/admin/docs/overview.md",
            "output": "packages/admin/docs/images/screenshots/page-history-rollback-preview.png",
            "required": true,
            "notes": "Authentic validated roll-forward preview showing the target revision, reversible append-only recovery explanation, and real field-level differences before confirmation."
        },
        {
