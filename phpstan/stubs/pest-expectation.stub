<?php

namespace Pest {
    /**
     * @template TValue
     *
     * @property \Pest\Expectations\OppositeExpectation $not Creates the opposite expectation.
     * @property \Pest\Expectations\EachExpectation $each Creates an expectation on each element on the traversable value.
     * @property \Pest\Arch\PendingArchExpectation $classes
     * @property \Pest\Arch\PendingArchExpectation $traits
     * @property \Pest\Arch\PendingArchExpectation $interfaces
     * @property \Pest\Arch\PendingArchExpectation $enums
     *
     * @mixin \Pest\Mixins\Expectation<TValue>
     * @mixin \Pest\Arch\PendingArchExpectation
     *
     * @method self toContainNone(array<int, mixed> $needles) Registered in tests/Pest.php through expect()->extend().
     */
    final class Expectation {}
}
